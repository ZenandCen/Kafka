{
  "name": "opensearch-sink-wikipedia-connector",
  "config": {
    "connector.class": "io.github.jenses.openconnect.OpenSearchSinkConnector",
    "tasks.max": "2",
    "topics": "wikipedia-events",
    "connection.url": "http://opensearch-node:9200",
    "type.name": "_doc",
    "key.ignore": "true",
    "schema.ignore": "true",
    "drop.invalid.message": "true",
    "bulk.size": "200",
    "flush.timeout.ms": "1000",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "false"
  }
}
